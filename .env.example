# SF Demo Builder — environment configuration
# Copy this to .env and fill in your values.
# Never commit .env to git.

# ── XSUAA / SAP IDP auth ──────────────────────────────────────────────────────
# JWKS endpoint for token signature verification
XSUAA_JWKS_URI=https://accounts.sap.com/oauth2/certs

# Issuer claim expected in the JWT
XSUAA_ISSUER=https://accounts.sap.com

# Public base URL of this server (used in OAuth2 Protected Resource metadata)
SERVER_BASE_URL=https://your-server.example.com

# ── HTTP transport ────────────────────────────────────────────────────────────
PORT=8000

# ── SAP SuccessFactors credentials ───────────────────────────────────────────
SF_ADMIN_USER=sfadmin@SFSALES011375
SF_ADMIN_PASS=your_sf_admin_password

# ── IAS SCIM credentials ─────────────────────────────────────────────────────
IAS_CLIENT_ID=your_ias_client_id
IAS_CLIENT_SECRET=your_ias_client_secret

# ── Email alias config ───────────────────────────────────────────────────────
# The local-part prefix before the + in user alias emails
# e.g. for siddhartha.bhattacharya+se.ceo@sap.com, set:
EMAIL_PREFIX=your.name
